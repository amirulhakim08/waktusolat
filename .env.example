# ---------------------------------------------------------------
# WaktuSolat environment variables. Copy to .env.local for local
# development; set the same keys in Vercel → Project → Settings →
# Environment Variables for production. NEVER commit real values.
# ---------------------------------------------------------------

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for e-mail verification redirects)
NEXT_PUBLIC_SITE_URL=https://waktusolat.vercel.app

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string

# Optional transactional e-mail for approval decisions (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="WaktuSolat <noreply@your-domain.my>"

# Only for scripts/bootstrap-master.ts (run once, locally or in CI)
MASTER_EMAIL=
MASTER_PASSWORD=
MASTER_NAME=
